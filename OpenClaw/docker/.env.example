# Copy to .env and edit. Plain KEY=value lines. Names follow OpenClaw's own
# docker setup where one exists.

# Gateway token for the Control UI. Generate one: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=

# ssh login as user `node`: set a public key (preferred), a password, or both.
# Example: SSH_PUBLIC_KEY=ssh-ed25519 AAAA... you@host
SSH_PUBLIC_KEY=
SSH_PASSWORD=

# Host ports, bound to 127.0.0.1 only. These defaults leave 22 and 18789 free
# for an OpenClaw running on the host.
SSH_PORT=2222
OPENCLAW_GATEWAY_PORT=18790

# Optional overrides.
# OPENCLAW_IMAGE=ghcr.io/openclaw/openclaw:latest
# BENTCLAW_IMAGE=ghcr.io/bentclaw/bentclaw:latest
# OPENCLAW_TZ=UTC
REPO_URL=https://github.com/bentman/BentClaw.git
