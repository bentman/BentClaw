# Copy to .env and edit. Plain KEY=value lines; the file is parsed, not executed.

# Linux account that gets the tools. Created if missing (with sudo rights);
# an existing account keeps its current password.
openclaw_user=openclaw
openclaw_pswd=replace-with-a-strong-password

# Minimum Node.js major version (installed from NodeSource if older/missing).
node_major=26

# Cloned into ~/WORK/CODE/REPO/BentClaw if not already there.
repo_url=https://github.com/bentman/BentClaw.git
